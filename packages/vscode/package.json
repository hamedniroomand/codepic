{
  "name": "codepic-vscode",
  "displayName": "CodePic",
  "version": "0.1.0",
  "private": true,
  "description": "Open the selected code in CodePic and turn it into an image.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "code",
    "image",
    "screenshot",
    "snippet"
  ],
  "homepage": "https://codepic.kitdev.space/",
  "bugs": {
    "url": "https://github.com/hamedniroomand/codepic/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedniroomand/codepic.git",
    "directory": "packages/vscode"
  },
  "publisher": "codepic",
  "main": "dist/extension.cjs",
  "scripts": {
    "build": "vp pack"
  },
  "devDependencies": {
    "@types/vscode": "1.140.0",
    "vscode-uri": "3.2.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "codepic.open",
        "title": "Open in CodePic",
        "category": "CodePic"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codepic.open",
          "group": "9_cutcopypaste"
        }
      ]
    }
  },
  "activationEvents": [],
  "engines": {
    "vscode": "^1.100.0"
  }
}
