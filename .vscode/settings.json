{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "oxc.path.oxfmt": "./node_modules/vite-plus/bin/oxfmt",
  "oxc.path.oxlint": "./node_modules/vite-plus/bin/oxlint",
  "oxc.fmt.configPath": "vite.config.ts",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.removeUnusedImports": "explicit"
  },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[vue]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "oxc.typeAware": true,
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true,
  "npm.scriptRunner": "bun",
  "files.trimTrailingWhitespace": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsserver.maxMemory": 8192,
  "js/ts.preferences.importModuleSpecifier": "non-relative"
}
